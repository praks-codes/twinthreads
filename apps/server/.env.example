NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
ROOM_IDLE_MINUTES=30
RECONNECT_GRACE_SECONDS=60
LOG_LEVEL=info

# Optional AI settings. These values are also the defaults.
# AI_PROVIDER: ollama, openai-compatible (with AI_BASE_URL) or none (backup lines)
AI_PROVIDER=ollama
AI_MODEL=gemma3:4b
AI_TIMEOUT_SECONDS=45
# AI_BASE_URL=http://127.0.0.1:11434
# AI_API_KEY=
